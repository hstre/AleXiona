## ── LLM Provider ───────────────────────────────────────────────────────────────
# Can also be configured inside the app via the ⚙ gear icon (persists across restarts).

# Provider: openai | groq | mistral | anthropic | ollama | openai_compatible
LLM_PROVIDER=openai

# API key — falls back to OPENAI_API_KEY for backwards compatibility
# Leave blank to configure via the in-app gear icon instead
LLM_API_KEY=

# Optional: override the provider's default model
LLM_MODEL=

# Required only for ollama (default: http://localhost:11434/v1) and openai_compatible
LLM_BASE_URL=

# Kept for backwards compatibility with OpenAI-only setups
OPENAI_API_KEY=

## ── Auth ───────────────────────────────────────────────────────────────────────
# HMAC secret for session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# A safe default is used automatically — change this in production.
SECRET_KEY=change-me-generate-a-real-secret

## ── Optional ───────────────────────────────────────────────────────────────────

# Log format: "json" (production, structured) | "text" (dev, coloured)
LOG_FORMAT=text

# Session token lifetime in hours (default: 8)
SESSION_MAX_AGE_HOURS=8

# Sentry DSN for error monitoring (leave empty to disable)
SENTRY_DSN=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

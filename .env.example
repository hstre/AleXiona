## ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# HMAC secret for session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-secret

# When set, POST /api/auth/session with role=clinician requires this value
# in the X-Bootstrap-Secret request header.  Leave unset for open dev access.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLINICIAN_BOOTSTRAP_SECRET=

## ── Optional ──────────────────────────────────────────────────────────────────

# Log format: "json" (production, structured) | "text" (dev, coloured)
LOG_FORMAT=text

# Session token lifetime in hours (default: 8)
SESSION_MAX_AGE_HOURS=8

# Sentry DSN for error monitoring (leave empty to disable)
SENTRY_DSN=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
